# Copy this file to .env and fill in your values. Never commit .env.

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Which Claude model to use. Leave blank to use the default in app/config.py.
ANTHROPIC_MODEL=

# Most analyses the server will run per 24 hours, for all visitors combined.
# This caps your Claude bill. Leave blank for the default (100).
DAILY_ANALYSIS_LIMIT=

# Port the backend listens on (the React dev server proxies /api here).
PORT=8000
